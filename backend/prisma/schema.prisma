// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Project {
  id               String         @id
  name             String
  description      String
  targetUsers      String?
  problemStatement String?
  status           String         @default("draft")
  technology       String?
  backend          String?
  database         String?

  user             User?          @relation(fields: [userId], references: [id])
  userId           String?

  discovery        DiscoveryStep[]
  requirements     Requirement[]
  architecture     Architecture?
  plan             DevelopmentPlan?
  executions       AgentExecution[]
  builds           ProjectBuild[]
  testRuns         TestRun[]
  fixHistory       FixRecord[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model DiscoveryStep {
  id        String   @id @default(uuid())
  role      String   // user or assistant
  content   String
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  createdAt DateTime @default(now())
}

model Requirement {
  id          String   @id @default(uuid())
  title       String
  description String
  priority    String
  type        String
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
}

model Architecture {
  id        String   @id @default(uuid())
  pattern   String
  layers    String   // JSON string
  modules   String   // JSON string
  dataFlow  String?
  apiStrategy String?
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String   @unique
}

model DevelopmentPlan {
  id        String   @id @default(uuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String   @unique
  phases    Phase[]
  createdAt DateTime @default(now())
}

model Phase {
  id          String          @id @default(uuid())
  title       String
  description String
  plan        DevelopmentPlan @relation(fields: [planId], references: [id])
  planId      String
  tasks       Task[]
}

model Task {
  id                 String   @id
  title              String
  description        String
  expectedOutput     String?
  filesToChange      String   // JSON string
  acceptanceCriteria String   // JSON string
  complexity         String
  status             String
  phase              Phase    @relation(fields: [phaseId], references: [id])
  phaseId            String
  dependencies       String   // JSON string
}

model AgentExecution {
  id           String         @id
  agentId      String
  status       String
  startedAt    DateTime
  completedAt  DateTime?
  checkpointId String?
  logs         ExecutionLog[]
  project      Project        @relation(fields: [projectId], references: [id])
  projectId    String
}

model ExecutionLog {
  id          Int            @id @default(autoincrement())
  timestamp   DateTime
  message     String
  details     String?
  execution   AgentExecution @relation(fields: [executionId], references: [id])
  executionId String
}

model ProjectBuild {
  id           String    @id
  platform     String
  status       String
  output       String
  startedAt    DateTime
  completedAt  DateTime?
  durationMs   Int?
  project      Project   @relation(fields: [projectId], references: [id])
  projectId    String
}

model TestRun {
  id           String    @id
  category     String
  status       String
  startedAt    DateTime
  completedAt  DateTime?
  totalCount   Int
  passedCount  Int
  failedCount  Int
  skippedCount Int
  coverage     Float?
  output       String
  project      Project   @relation(fields: [projectId], references: [id])
  projectId    String
}

model FixRecord {
  id            String   @id
  issue         String
  rootCause     String
  modifiedFiles String   // JSON string
  fixSummary    String
  buildResult   String
  testResult    String
  timestamp     DateTime
  project       Project  @relation(fields: [projectId], references: [id])
  projectId     String
}
